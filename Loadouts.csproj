<Project Sdk="NeoRune.Sdk/1.0.0">
  <!--
    dotnet build   compiles the mod and installs it into the game's Paks\~mods\Loadouts folder.
    Close the game before building: it locks the mod files while running.
  -->
  <PropertyGroup>
    <!-- The game on this machine (Steam). Builds don't need it, only installing does. -->
    <NeoRuneGameDir>C:\Program Files (x86)\Steam\steamapps\common\Minecraft Dungeons II</NeoRuneGameDir>
    <!-- On the build server (GitHub Actions sets CI=true) there's no game to install into. -->
    <NeoRuneInstall Condition="'$(CI)' == 'true'">false</NeoRuneInstall>
    <!-- Shown in the Mods tab of the game's settings (Blueprint Loader 2.0). \n in the description is a line break. -->
    <NeoRuneModTitle>Loadouts</NeoRuneModTitle>
    <!-- Releases take their version from the tag (v1.2 -> 1.2): see .github/workflows/build.yml. -->
    <Version>1.1</Version>
    <NeoRuneModAuthor>Kyle</NeoRuneModAuthor>
    <NeoRuneModDescription>Save the gear you have on as a loadout, and switch between loadouts in one press, enchantments included: the gear you take off is disenchanted (its enchantment points come back) and the gear you put on is enchanted again as it was saved.\nOn the inventory page, the Loadouts button beside Effects &amp; Stats (or right stick click, or L) opens them: equip, save, rename and clear loadouts there.\nA key for "next loadout" can be set below, to switch anywhere.</NeoRuneModDescription>
  </PropertyGroup>
  <!--
    The mod kit (ModKit): shared code for these mods, compiled in. Next to the mod while working on it; in a ModKit folder
    inside the mod on the build server (GitHub Actions checks it out there). It also gives development builds the DEBUG
    symbol (diagnostics on), and the mod its version and repository for the update check.
  -->
  <PropertyGroup>
    <ModKitRepo>kjohnson2719/mcd2-loadouts</ModKitRepo>
    <ModKitDir Condition="'$(ModKitDir)' == '' and Exists('$(MSBuildProjectDirectory)\ModKit\ModKit.targets')">$(MSBuildProjectDirectory)\ModKit\</ModKitDir>
    <ModKitDir Condition="'$(ModKitDir)' == ''">$(MSBuildProjectDirectory)\..\ModKit\</ModKitDir>
  </PropertyGroup>
  <Import Project="$(ModKitDir)ModKit.targets" />
</Project>
